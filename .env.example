# .env.local にコピーして値を入れる（.env.local はコミットしない）
#
# 開発（npm run dev）と E2E は手元の Supabase を使う（architecture.md 7 章）。本番の値は Vercel の環境変数にだけ置く。
#   1. npx supabase start        （Docker Desktop が必要）
#   2. npx supabase db reset     （初回とマイグレーションを足した後。シード supabase/seed.sql でテスト農園 A / B を作る）
#   3. npx supabase status       （API URL / Publishable key / Secret（service_role）key を表示する）
# E2E は NEXT_PUBLIC_SUPABASE_URL が 127.0.0.1 / localhost でなければ global-setup で止まる（本番の無料枠を使わないため）。

# 手元の Supabase。`npx supabase status` の API URL と Publishable（anon）key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# E2E 用。A: 主に使う / B: 組織の分離の検証のみ。supabase/seed.sql が作るアカウント（開発用の固定パスワード）
E2E_EMAIL=test-a@example.com
E2E_PASSWORD=local-dev-password-a
E2E_B_EMAIL=test-b@example.com
E2E_B_PASSWORD=local-dev-password-b

# 気温の日次取り込み（3-1、/api/cron/weather）。サーバー側だけで使う。NEXT_PUBLIC_ を付けない
# CRON_SECRET: Cron の Route Handler が照合するシークレット。手元は開発用の固定値でよい（本番は Vercel に別の長い値）
# SUPABASE_SERVICE_ROLE_KEY: `npx supabase status` の Secret（service_role）key。Cron の Route Handler だけが使う（architecture.md 2・7 章の例外）
CRON_SECRET=local-dev-cron-secret
SUPABASE_SERVICE_ROLE_KEY=
