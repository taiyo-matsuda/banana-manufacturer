# .env.local にコピーして値を入れる
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# E2E 用。A: 主に使う / B: 組織の分離の検証のみ
E2E_EMAIL=
E2E_PASSWORD=
E2E_B_EMAIL=
E2E_B_PASSWORD=
# 気温の日次取り込み（3-1、/api/cron/weather）。サーバー側だけで使う。NEXT_PUBLIC_ を付けない・値はコミットしない
# CRON_SECRET: Vercel Cron が Authorization: Bearer で送るシークレット（Vercel の環境変数にも同じ値を設定）
# SUPABASE_SERVICE_ROLE_KEY: service_role（Secret key）。Cron の Route Handler だけが使う（architecture.md 2・7 章の例外）
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
